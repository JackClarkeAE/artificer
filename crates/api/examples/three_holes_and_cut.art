// Block with 3 circle holes and a crossing side cut
let base = box(size=[100.0, 100.0, 40.0]);
let s1 = sketch(on=base.top_face);
s1.circle(center=[25.0, 25.0], radius=8.0);
s1.circle(center=[75.0, 25.0], radius=8.0);
s1.circle(center=[50.0, 75.0], radius=8.0);
let cut1 = extrude(sketch=s1, distance=40.0, op="cut");
let s2 = sketch(on=cut1.face("-Y"));
s2.circle(center=[50.0, 20.0], radius=10.0);
let cut2 = extrude(sketch=s2, distance=30.0, op="cut");
snapshot("three_holes_and_cut.svg", view="trimetric");
